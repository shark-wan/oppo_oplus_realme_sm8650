diff --git a/drivers/of/fdt.c b/drivers/of/fdt.c
index 335d39eeb..58cabd135 100644
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -1186,6 +1186,16 @@ int __init early_init_dt_scan_chosen(char *cmdline)
 
 	chosen_node_offset = node;
 
+	/*
+	 * MKP's vendor policy checker is not namespace-aware. DroidSpaces
+	 * legitimately creates additional credential/user-namespace states,
+	 * but the vendor module treats policy-4 mismatches as fatal when this
+	 * property is "on". Preserve checking and diagnostics while preventing
+	 * a false-positive policy warning from becoming a reboot.
+	 */
+	if (of_get_flat_dt_prop(node, "mkp_panic", &l))
+		fdt_setprop(initial_boot_params, node, "mkp_panic", "off", 4);
+
 	early_init_dt_check_for_initrd(node);
 	early_init_dt_check_for_elfcorehdr(node);

